{
  "name": "earshot-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Earshot: your television already has the evidence that you are losing your hearing. It has just never been asked. Passive detection from listening level, a validated digits-in-noise screen on the remote, and a route to the help Fire TV already ships.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "test": "vitest run && npm --prefix tv test",
    "typecheck": "tsc -b packages/digits-in-noise packages/earshot-core",
    "build:packages": "tsc -b packages/digits-in-noise packages/earshot-core",
    "pretest": "npm run build:packages",
    "validate": "npm run validate -w @earshot/eval",
    "digits:placeholder": "npm run digits:placeholder -w @earshot/pipeline",
    "digits": "npm run digits -w @earshot/pipeline",
    "analyse": "npm run analyse -w @earshot/pipeline",
    "postinstall": "npm --prefix tv install --no-audit --no-fund",
    "test:tv": "npm --prefix tv test",
    "bundle:tv": "npm --prefix tv run bundle",
    "web:dev": "npm run dev -w @earshot/web",
    "web:build": "npm run build -w @earshot/web",
    "mcp": "npm run dev -w @earshot/mcp",
    "deploy": "npm run web:build && npx cdk deploy --require-approval never --app \"npx tsx bin/app.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
